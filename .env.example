# =============================================================================
# .env.example — root environment for Docker Compose + scripts
#
#   cp .env.example .env   # then EDIT — .env is git-ignored, never commit it
#
# Values here are placeholders only; no real secrets are committed anywhere.
# Compose reads this file automatically; scripts/init-db.sh also falls back to
# it. The backend app has its OWN env file at backend/.env (see
# backend/.env.example) for non-Docker local development.
# =============================================================================

# --- Postgres (the `db` service in docker-compose.yml) ------------------------
# Superuser created inside the db container. REQUIRED by compose.
POSTGRES_USER=postgres
# Password for that superuser. REQUIRED by compose — it refuses to start
# without it. Use a long random value; must be URL-safe if you rely on the
# auto-built DATABASE_URL below (no @ : / # ? — otherwise set DATABASE_URL
# yourself with the password percent-encoded).
POSTGRES_PASSWORD=
# Main database created in the db container (also the compose default target).
POSTGRES_DB=mc_admin

# --- Extra admin DB/role (docker/initdb/01-create-admin-db.sql) ---------------
# Ensured on FIRST init of the db volume. Leave the defaults for a normal
# stack (no-op when equal to POSTGRES_DB/POSTGRES_USER). To keep the admin
# panel on a SEPARATE database of a shared server, set POSTGRES_DB to the
# shared name and leave ADMIN_DB_NAME=mc_admin.
ADMIN_DB_NAME=mc_admin
ADMIN_DB_USER=postgres
# Password applied only when this script CREATES the role; empty = skip.
ADMIN_DB_PASSWORD=

# --- Connecting to an EXISTING Postgres server (scripts/init-db.sh) -----------
# Only used by scripts/init-db.sh (and by you when pointing DATABASE_URL at an
# external server). Defaults shown.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
# Role/database for the app itself when bootstraping an external server.
POSTGRES_APP_USER=postgres
POSTGRES_APP_PASSWORD=
# Container name scripts/init-db.sh execs into (docker-exec mode).
DOCKER_DB_CONTAINER=mc-admin

# --- Backend connection string ------------------------------------------------
# If left EMPTY, compose builds a sensible default:
#   postgresql+asyncpg://<POSTGRES_USER>:<POSTGRES_PASSWORD>@db:5432/<POSTGRES_DB>
# Set it explicitly to point at an external server (e.g. the shared mc-admin
# container's host) or when the password needs URL-encoding.
DATABASE_URL=

# --- Backend app --------------------------------------------------------------
# JWT signing key. REQUIRED by compose — use a long random string, e.g.
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=
# JSON list of allowed browser origins for CORS.
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:5174","http://127.0.0.1:5174"]
# Host port the API is published on.
BACKEND_PORT=8000
# development | production (affects error verbosity in the app).
ENVIRONMENT=production
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
MAX_UPLOAD_SIZE_MB=10
# Seconds the backend entrypoint waits for Postgres before giving up.
DB_WAIT_TIMEOUT=60
# Tag/name for the built backend image (optional).
BACKEND_IMAGE=mc-admin-backend:latest
